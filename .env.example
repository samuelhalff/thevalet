# Public build-time settings. Copy to .env.local for local builds. Everything is optional except
# the site URL; empty values render nothing on the site (no placeholders, no fake details).
# Must be thevalet.ch or a preview host (*.thevalet.ch, localhost):
NEXT_PUBLIC_SITE_URL=https://thevalet.ch
# true until the site is ready: noindex everywhere + robots.txt Disallow: /
NEXT_PUBLIC_NOINDEX=true
NEXT_PUBLIC_GA_ID=
# Formspark form id (no default: the forms explain that online sending is not active yet)
NEXT_PUBLIC_FORMSPARK_ID=
# International format digits only, e.g. 41791234567 (WhatsApp button shown only when set)
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# Operator identity (legal notice, privacy policy, JSON-LD)
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_UID=
NEXT_PUBLIC_COMPANY_STREET=
NEXT_PUBLIC_COMPANY_POSTCODE=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_COUNTRY=CH
NEXT_PUBLIC_COMPANY_RESPONSIBLE=
NEXT_PUBLIC_HOSTING_PROVIDER=
# Verified public profiles only, comma-separated (Instagram, LinkedIn, Google Business Profile)
NEXT_PUBLIC_SAME_AS=
